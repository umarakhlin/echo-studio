# העתיקי שורה זו לקובץ .env.local (בשורש הפרויקט) או הוסיפי שם:
#
#   NEXT_PUBLIC_WHATSAPP_PHONE=972501234567
#
# 972 = ישראל, אחר כך המספר הנייד בלי 0 (050-… → 97250…)
# אחרי שינוי: עצרי npm run dev והפעילי מחדש.
#
NEXT_PUBLIC_WHATSAPP_PHONE=

# --- כניסת סטודיו (לוח ניהול /admin) -------------------------------------
# מפתח אקראי באורך 16+ תווים — חתימת עוגיית סשן (להפקה: openssl rand -hex 32)
STUDIO_SESSION_SECRET=
#
# משתמש מורשה אחד לכל שורה:
#   STUDIO_USER_<שם_באותיות_גדולות>=סיסמה
# בטופס הכניסה: אותו שם באותיות קטנות (sara עבור STUDIO_USER_SARA)
# רק משתמשים שמוגדרים כאן יכולים להיכנס — כולם רואים את אותו לוח.
#
# ב-Vercel/Next פרודקשן רק סיומות שמופיעות במפורש בקוד נטענות כך —
# או משתמשים בשורת JSON אחת (מומלץ למשתמשים רבים / שמות מותאמים):
#   STUDIO_USERS={"uma":"SuperSecretMin6","noa_klein":"OtherPass789"}
#
# STUDIO_USER_SARA=SuperSecretPass123
# STUDIO_USER_NOA_KLEIN=AnotherPass456
#
# --- פריסה (Vercel וכו.) -----------------------------------------------
# ב-Vercel: Project Settings → Environment Variables — אותן משתנים כמו כאן.
# חובה לכניסת /admin: STUDIO_SESSION_SECRET + לפחות שורת STUDIO_USER_* אחת.
#
# --- שלב 3: נתונים בענן (Supabase) ----------------------------------------
# ברירת מחדל: local (IndexedDB בדפדפן בלבד).
# NEXT_PUBLIC_DATA_BACKEND=local
#
# מצב ענן — חובה בפרויקט Supabase: להריץ את supabase/migrations/001_echo_cloud.sql
# וליצור bucket echo-photos (המיגרציה מגדירה אותו public).
# NEXT_PUBLIC_DATA_BACKEND=cloud
# (בפלטפורמות פריסה: ייתכן שמוגדר NEXT_PUBLIC_BACKEND=cloud — גם זה נתמך.)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# מפתח שירות — רק בשרת (לעולם לא בקוד ציבורי / בדפדפן):
# SUPABASE_SERVICE_ROLE_KEY=
# אם הוגדר תחת שם חלופי ב-Vercel:
# SUPABASE_ROLE_KEY=
# אופציונלי ללקוח (אם בעתיד תשתמשי ב-SDK ישיר מהדפדפן):
# שיפור איכות תמונה (AI) בדף האלבום ללקוח — אופציונלי
# מפתח מ-https://replicate.com/account/api-tokens — תשלום לפי שימוש (Real-ESRGAN)
# REPLICATE_API_TOKEN=
